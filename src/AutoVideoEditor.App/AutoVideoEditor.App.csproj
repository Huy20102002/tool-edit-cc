<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AutoVideoEditor.App</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoVideoEditor.Core\AutoVideoEditor.Core.csproj" />
    <ProjectReference Include="..\AutoVideoEditor.Infrastructure\AutoVideoEditor.Infrastructure.csproj" />
    <ProjectReference Include="..\AutoVideoEditor.AudioEngine\AutoVideoEditor.AudioEngine.csproj" />
    <ProjectReference Include="..\AutoVideoEditor.VideoEngine\AutoVideoEditor.VideoEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

</Project>
