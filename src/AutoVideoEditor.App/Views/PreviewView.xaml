<UserControl x:Class="AutoVideoEditor.App.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:AutoVideoEditor.App.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header & Select File -->
            <Border Grid.Row="0" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Phân Tích Sóng Âm &amp; Cắt Khoảng Lặng (Silence Detection)" FontSize="18" FontWeight="Bold" Foreground="#f4f4f5" />
                        <TextBlock Text="{Binding CurrentVoiceFileName, StringFormat='File hiện tại: {0}'}" FontSize="13" Foreground="#06b6d4" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="📂 Chọn file giọng đọc khác" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectVoiceFileCommand}" Margin="0,0,8,0" />
                        <Button Content="🔄 Phân tích lại" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeCurrentVoiceCommand}" IsEnabled="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Waveform Visualization -->
            <Border Grid.Row="2" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Sóng âm trực quan (Màu xanh: Giọng nói | Màu đỏ: Khoảng lặng đã cắt)" FontSize="14" FontWeight="SemiBold" Foreground="#a1a1aa" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="12" Height="12" Fill="#10b981" RadiusX="2" RadiusY="2" Margin="0,0,4,0" />
                            <TextBlock Text="Giọng nói" Foreground="#f4f4f5" FontSize="11" Margin="0,0,12,0" />
                            <Rectangle Width="12" Height="12" Fill="#ef4444" RadiusX="2" RadiusY="2" Margin="0,0,4,0" />
                            <TextBlock Text="Khoảng lặng" Foreground="#f4f4f5" FontSize="11" />
                        </StackPanel>
                    </Grid>
                    
                    <controls:WaveformControl Height="120" AnalysisResult="{Binding AnalysisResult}" />
                </StackPanel>
            </Border>

            <!-- Comparison Stats Card (Original vs Processed) -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Thời lượng gốc" FontSize="12" Foreground="#71717a" />
                        <TextBlock Text="{Binding AnalysisResult.OriginalDurationSeconds, StringFormat='{}{0:F2} giây'}" FontSize="22" FontWeight="Bold" Foreground="#f4f4f5" Margin="0,4,0,0" />
                        <TextBlock Text="Toàn bộ file âm thanh ban đầu" FontSize="11" Foreground="#a1a1aa" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#18181b" BorderBrush="#3f1a1a" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Khoảng lặng đã loại bỏ" FontSize="12" Foreground="#ef4444" />
                        <TextBlock Text="{Binding AnalysisResult.SilenceDurationRemovedSeconds, StringFormat='{}{0:F2} giây'}" FontSize="22" FontWeight="Bold" Foreground="#ef4444" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding AnalysisResult.SilenceRemovalPercentage, StringFormat='Giảm {0:F1}% thời lượng dư thừa'}" FontSize="11" Foreground="#a1a1aa" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#18181b" BorderBrush="#1e3a2b" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Thời lượng Master Video" FontSize="12" Foreground="#10b981" />
                        <TextBlock Text="{Binding AnalysisResult.ProcessedDurationSeconds, StringFormat='{}{0:F2} giây'}" FontSize="22" FontWeight="Bold" Foreground="#10b981" Margin="0,4,0,0" />
                        <TextBlock Text="Video cuối cùng sẽ khớp chính xác số giây này" FontSize="11" Foreground="#a1a1aa" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Silence Parameters & Segments Table -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Parameter Adjustment -->
                <Border Grid.Column="0" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Thông số phát hiện khoảng lặng" FontSize="14" FontWeight="SemiBold" Foreground="#f4f4f5" Margin="0,0,0,16" />

                        <!-- Threshold dB -->
                        <TextBlock Text="{Binding SilenceThresholdDb, StringFormat='Ngưỡng âm lượng: {0:F0} dB'}" Foreground="#a1a1aa" FontSize="12" />
                        <Slider Minimum="-50" Maximum="-15" Value="{Binding SilenceThresholdDb}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,16" />

                        <!-- Min Silence ms -->
                        <TextBlock Text="{Binding MinSilenceMs, StringFormat='Độ dài khoảng lặng tối thiểu: {0} ms'}" Foreground="#a1a1aa" FontSize="12" />
                        <Slider Minimum="100" Maximum="1000" Value="{Binding MinSilenceMs}" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,6,0,16" />

                        <!-- Padding Before ms -->
                        <TextBlock Text="{Binding PaddingBeforeMs, StringFormat='Khoảng đệm trước câu: {0} ms'}" Foreground="#a1a1aa" FontSize="12" />
                        <Slider Minimum="0" Maximum="200" Value="{Binding PaddingBeforeMs}" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,6,0,16" />

                        <!-- Padding After ms -->
                        <TextBlock Text="{Binding PaddingAfterMs, StringFormat='Khoảng đệm sau câu: {0} ms'}" Foreground="#a1a1aa" FontSize="12" />
                        <Slider Minimum="0" Maximum="200" Value="{Binding PaddingAfterMs}" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,6,0,20" />

                        <Button Content="⚡ Áp dụng &amp; Phân tích lại" Style="{StaticResource CyanButtonStyle}" Command="{Binding AnalyzeCurrentVoiceCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- Speech Segments List -->
                <Border Grid.Column="2" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding SpeechSegments.Count, StringFormat='Danh sách đoạn phát âm giữ lại ({0} đoạn)'}" FontSize="14" FontWeight="SemiBold" Foreground="#f4f4f5" Margin="0,0,0,12" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SpeechSegments}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                  RowBackground="#18181b" AlternatingRowBackground="#121215" Foreground="#f4f4f5"
                                  HorizontalGridLinesBrush="#27272a" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartSeconds, StringFormat='{}{0:F2}s'}" Width="*" />
                                <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndSeconds, StringFormat='{}{0:F2}s'}" Width="*" />
                                <DataGridTextColumn Header="Thời lượng" Binding="{Binding DurationSeconds, StringFormat='{}{0:F2}s'}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
