<UserControl x:Class="AutoVideoEditor.App.Views.PresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:enums="clr-namespace:AutoVideoEditor.Core.Enums;assembly=AutoVideoEditor.Core"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Preset List Column -->
        <Border Grid.Column="0" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Danh sách mẫu xuất (Presets)" FontSize="16" FontWeight="Bold" Foreground="#f4f4f5" Margin="0,0,0,12" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#121215" BorderBrush="#27272a" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#f4f4f5" FontSize="13" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#a1a1aa" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Foreground="#06b6d4" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}x{1} • {2} FPS">
                                                <Binding Path="ResolutionWidth" />
                                                <Binding Path="ResolutionHeight" />
                                                <Binding Path="Fps" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="📋 Nhân bản" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Command="{Binding DuplicatePresetCommand}" />
                    <Button Grid.Column="1" Content="⭐ Đặt mặc định" Style="{StaticResource CyanButtonStyle}" Margin="4,0,0,0" Command="{Binding SetAsDefaultPresetCommand}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Preset Editor Column -->
        <Border Grid.Column="2" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="12" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedPreset}">
                    <TextBlock Text="Cấu hình chi tiết Mẫu xuất" FontSize="18" FontWeight="Bold" Foreground="#f4f4f5" Margin="0,0,0,16" />

                    <!-- Name & Description -->
                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Tên mẫu xuất:" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Mô tả:" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="#27272a" Margin="0,0,0,16" />

                    <!-- Video Settings -->
                    <TextBlock Text="Cấu hình Video" FontSize="14" FontWeight="Bold" Foreground="#06b6d4" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chiều rộng (px):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ResolutionWidth, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chiều cao (px):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ResolutionHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Khung hình (FPS):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cách căn khung (Crop mode):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding CropMode}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Nền mờ tự động (Fit with Blur - CapCut style)" Tag="{x:Static enums:CropMode.FitWithBlur}" />
                                <ComboBoxItem Content="Cắt giữa (Center Crop)" Tag="{x:Static enums:CropMode.CenterCrop}" />
                                <ComboBoxItem Content="Vừa khung viền đen (Fit Black Bars)" Tag="{x:Static enums:CropMode.FitBlackBars}" />
                                <ComboBoxItem Content="Kéo giãn (Stretch)" Tag="{x:Static enums:CropMode.Stretch}" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bộ mã hóa Video (Encoder):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding HardwareEncoder}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Tự động (Auto GPU/CPU)" Tag="{x:Static enums:HardwareEncoderType.Auto}" />
                                <ComboBoxItem Content="NVIDIA NVENC" Tag="{x:Static enums:HardwareEncoderType.NvidiaNvenc}" />
                                <ComboBoxItem Content="AMD AMF" Tag="{x:Static enums:HardwareEncoderType.AmdAmf}" />
                                <ComboBoxItem Content="Intel QuickSync (QSV)" Tag="{x:Static enums:HardwareEncoderType.IntelQsv}" />
                                <ComboBoxItem Content="CPU (libx264)" Tag="{x:Static enums:HardwareEncoderType.CPU}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#27272a" Margin="0,0,0,16" />

                    <!-- Video & Audio Trimming Section -->
                    <TextBlock Text="✂️ Cắt Đầu / Cắt Đuôi &amp; Dư Cuối Video (Trim &amp; Outro Hold)" FontSize="14" FontWeight="Bold" Foreground="#eab308" Margin="0,0,0,8" />
                    <TextBlock Text="Tự động cắt bỏ số giây mở đầu/kết thúc và cấu hình số giây video chạy thêm sau khi giọng đọc kết thúc." FontSize="11" Foreground="#71717a" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cắt đầu Video (s):" Foreground="#a1a1aa" Margin="0,0,0,4" ToolTip="Số giây cắt bỏ ở đầu mỗi file video" />
                            <TextBox Text="{Binding VideoTrimStartSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cắt đuôi Video (s):" Foreground="#a1a1aa" Margin="0,0,0,4" ToolTip="Số giây cắt bỏ ở cuối mỗi file video" />
                            <TextBox Text="{Binding VideoTrimEndSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Cắt đầu Voice (s):" Foreground="#a1a1aa" Margin="0,0,0,4" ToolTip="Số giây cắt bỏ ở đầu mỗi file giọng đọc" />
                            <TextBox Text="{Binding VoiceTrimStartSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Cắt đuôi Voice (s):" Foreground="#a1a1aa" Margin="0,0,0,4" ToolTip="Số giây cắt bỏ ở cuối mỗi file giọng đọc" />
                            <TextBox Text="{Binding VoiceTrimEndSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Dư cuối Video (s):" Foreground="#eab308" FontWeight="SemiBold" Margin="0,0,0,4" ToolTip="Số giây video chạy thêm sau khi giọng đọc đã kết thúc" />
                            <TextBox Text="{Binding ExtraEndPaddingSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="#27272a" Margin="0,0,0,16" />

                    <!-- Transitions Section -->
                    <TextBlock Text="✨ Hiệu Ứng Chuyển Cảnh (Transitions)" FontSize="14" FontWeight="Bold" Foreground="#06b6d4" Margin="0,0,0,8" />
                    <TextBlock Text="Tự động chọn các điểm cắt đẹp trên timeline và thêm đúng số lượng hiệu ứng chuyển cảnh." FontSize="11" Foreground="#71717a" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số lượng chuyển cảnh:" Foreground="#a1a1aa" Margin="0,0,0,4" ToolTip="Số lượng transition trên 1 video (0 = Chỉ dùng Cut)" />
                            <TextBox Text="{Binding TransitionCount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kiểu chuyển cảnh:" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <ComboBox SelectedValue="{Binding TransitionType}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Thông minh (Smart)" Tag="{x:Static enums:TransitionType.Smart}" />
                                <ComboBoxItem Content="Ngẫu nhiên (Random)" Tag="{x:Static enums:TransitionType.Random}" />
                                <ComboBoxItem Content="Hòa tan (Dissolve)" Tag="{x:Static enums:TransitionType.Dissolve}" />
                                <ComboBoxItem Content="Thu phóng (Zoom)" Tag="{x:Static enums:TransitionType.Zoom}" />
                                <ComboBoxItem Content="Mờ dần (Fade)" Tag="{x:Static enums:TransitionType.Fade}" />
                                <ComboBoxItem Content="Trượt (Slide)" Tag="{x:Static enums:TransitionType.Slide}" />
                                <ComboBoxItem Content="Quét (Wipe)" Tag="{x:Static enums:TransitionType.Wipe}" />
                                <ComboBoxItem Content="Chỉ cắt (Cut)" Tag="{x:Static enums:TransitionType.Cut}" />
                                <ComboBoxItem Content="Không dùng (None)" Tag="{x:Static enums:TransitionType.None}" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Thời lượng hiệu ứng (s):" Foreground="#a1a1aa" Margin="0,0,0,4" ToolTip="Thời lượng chuyển cảnh (mặc định 0.20s)" />
                            <TextBox Text="{Binding TransitionDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Khoảng cách tối thiểu (s):" Foreground="#a1a1aa" Margin="0,0,0,4" ToolTip="Khoảng cách tối thiểu giữa 2 lần chuyển cảnh" />
                            <TextBox Text="{Binding MinTransitionSpacingSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="#27272a" Margin="0,0,0,16" />

                    <!-- Audio Settings -->
                    <TextBlock Text="Cấu hình Âm thanh &amp; Khoảng lặng" FontSize="14" FontWeight="Bold" Foreground="#10b981" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngưỡng khoảng lặng (dB):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SilenceThresholdDb, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Khoảng lặng tối thiểu (ms):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding MinSilenceDurationMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Khoảng đệm câu (ms):" Foreground="#a1a1aa" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PaddingBeforeMs, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="🗑️ Xóa mẫu xuất" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Margin="0,0,8,0" />
                        <Button Content="💾 Lưu thay đổi" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding DataContext.SaveCurrentPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
