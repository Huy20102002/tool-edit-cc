<UserControl x:Class="AutoVideoEditor.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- Top Section: Queue Controls & DataGrid -->
            <RowDefinition Height="3*" MinHeight="220" />
            <!-- Splitter -->
            <RowDefinition Height="10" />
            <!-- Bottom Section: Realtime Log Panel -->
            <RowDefinition Height="2*" MinHeight="160" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- TOP SECTION: QUEUE CONTROLS & TABLE                               -->
        <!-- ================================================================= -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Action Bar & Stat Badges -->
            <Border Grid.Row="0" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Batch Control Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="▶ Bắt đầu tất cả" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartQueueCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}" />
                        <Button Content="⏸ Tạm dừng" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PauseQueueCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsProcessing}" />
                        <Button Content="⏹ Hủy tất cả" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelAllCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsProcessing}" />
                        <Button Content="🔄 Thử lại lỗi" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RetryFailedCommand}" Margin="0,0,8,0" />
                        <Button Content="🧹 Xóa đã xong" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCompletedCommand}" Margin="0,0,8,0" />
                        <Button Content="🗑️ Xóa tất cả" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearAllCommand}" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Stats Badges & Folder Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#27272a" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="{Binding TotalCount, StringFormat='Tổng: {0} video'}" Foreground="#f4f4f5" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="#1e3a2b" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="{Binding CompletedCount, StringFormat='Hoàn thành: {0}'}" Foreground="#10b981" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="#3f1a1a" CornerRadius="6" Padding="10,6" Margin="0,0,14,0" Visibility="{Binding FailedCount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FailedCount, StringFormat='Lỗi: {0}'}" Foreground="#ef4444" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Button Content="📂 Mở thư mục xuất" Style="{StaticResource CyanButtonStyle}" Command="{Binding OpenOutputFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Job Queue DataGrid -->
            <Border Grid.Row="2" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="10" Padding="8">
                <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#27272a" HeadersVisibility="Column"
                          RowBackground="#18181b" AlternatingRowBackground="#121215"
                          Foreground="#f4f4f5" SelectionMode="Single" SelectionUnit="FullRow">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#09090b" />
                            <Setter Property="Foreground" Value="#a1a1aa" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#27272a" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Padding" Value="0,6" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#27272a" />
                                    <Setter Property="Foreground" Value="#ffffff" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTextColumn Header="STT" Binding="{Binding OrderIndex, StringFormat='{}{0:D2}'}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="#71717a" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Video File -->
                        <DataGridTextColumn Header="Video đầu vào" Binding="{Binding VideoFileName}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Voice File -->
                        <DataGridTextColumn Header="Giọng đọc" Binding="{Binding VoiceFileName}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#a1a1aa" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Custom Trim & Outro Padding -->
                        <DataGridTemplateColumn Header="Cắt / Dư cuối" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="11" Foreground="#eab308">
                                            <Run Text="Video: -" /><Run Text="{Binding VideoTrimStartSeconds, StringFormat='{}{0:F1}'}" /><Run Text="s / -" /><Run Text="{Binding VideoTrimEndSeconds, StringFormat='{}{0:F1}'}" /><Run Text="s" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="#10b981" Margin="0,2,0,0">
                                            <Run Text="Dư cuối: +" /><Run Text="{Binding ExtraEndPaddingSeconds, StringFormat='{}{0:F1}'}" /><Run Text="s" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#09090b" BorderBrush="{Binding Status, Converter={StaticResource JobStatusToBrush}}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource JobStatusToVietnamese}}"
                                                   Foreground="{Binding Status, Converter={StaticResource JobStatusToBrush}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Progress Bar & Percentage -->
                        <DataGridTemplateColumn Header="Tiến độ" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding CurrentStepDescription}" FontSize="11" Foreground="#a1a1aa" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ProgressPercentage, Converter={StaticResource DoubleToPercent}}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#f4f4f5" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Speed & ETA -->
                        <DataGridTemplateColumn Header="Tốc độ / ETA" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Speed, StringFormat='{}{0:F1}x speed'}" FontSize="11" Foreground="#06b6d4" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding EstimatedTimeRemaining, Converter={StaticResource FormatEta}}" FontSize="10" Foreground="#71717a" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="Thao tác" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="▶ Xem" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenJobOutputFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="✕" Style="{StaticResource DangerButtonStyle}" Padding="6,3" FontSize="11"
                                                Command="{Binding DataContext.CancelSingleJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- RESIZABLE SPLITTER                                                -->
        <!-- ================================================================= -->
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="#27272a" ShowsPreview="True" Cursor="SizeNS" />

        <!-- ================================================================= -->
        <!-- BOTTOM SECTION: NHẬT KÝ XỬ LÝ (REALTIME LOG PANEL)                -->
        <!-- ================================================================= -->
        <Border Grid.Row="2" Background="#121215" BorderBrush="#27272a" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Log Header & Batch Summary -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <!-- Log Stream List -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Batch Summary -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📜" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="NHẬT KÝ XỬ LÝ" FontSize="14" FontWeight="Bold" Foreground="#f4f4f5" VerticalAlignment="Center" Margin="0,0,16,0" />
                        
                        <Border Background="#18181b" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BatchSummaryText}" FontSize="12" FontWeight="Bold" Foreground="#06b6d4" />
                        </Border>
                    </StackPanel>

                    <!-- Batch Progress Bar in Log Header -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0" HorizontalAlignment="Left">
                        <TextBlock Text="Tiến độ tổng:" FontSize="11" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Width="140" Height="7" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OverallProgress, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="#10b981" VerticalAlignment="Center" Margin="8,0,0,0" />
                        
                        <TextBlock Text="Đang xử lý:" FontSize="11" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <TextBlock Text="{Binding ProcessingCount}" FontSize="11" FontWeight="Bold" Foreground="#06b6d4" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <TextBlock Text="Đang chờ:" FontSize="11" Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding PendingCount}" FontSize="11" FontWeight="Bold" Foreground="#a1a1aa" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Log Action Toolbar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🗑️ Xóa nhật ký" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearLogsCommand}" Padding="10,5" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="💾 Lưu nhật ký" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveLogsToFileCommand}" Padding="10,5" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="📋 Sao chép" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CopyLogsToClipboardCommand}" Padding="10,5" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="↓ Mới nhất" Style="{StaticResource CyanButtonStyle}" Command="{Binding ScrollToLatestCommand}" Padding="10,5" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Realtime Log Stream List -->
                <Border Grid.Row="2" Background="#09090b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="LogScrollViewer_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp, StringFormat='[{0}]'}"
                                                   Foreground="#71717a" FontSize="11" FontFamily="Consolas, Cascadia Code, monospace" VerticalAlignment="Center" />

                                        <!-- Level Badge -->
                                        <Border Grid.Column="1" Background="{Binding Level, Converter={StaticResource LogLevelToBgBrush}}"
                                                CornerRadius="4" Padding="6,2" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                                       FontSize="10" FontWeight="Bold" FontFamily="Consolas, Cascadia Code, monospace" />
                                        </Border>

                                        <!-- Job Tag -->
                                        <TextBlock Grid.Column="2" Text="{Binding JobTag}" Foreground="#06b6d4" FontWeight="SemiBold"
                                                   FontSize="11" FontFamily="Consolas, Cascadia Code, monospace" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <!-- Message -->
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                                   FontSize="12" FontFamily="Consolas, Cascadia Code, monospace" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
