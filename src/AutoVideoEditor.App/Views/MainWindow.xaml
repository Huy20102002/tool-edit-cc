<Window x:Class="AutoVideoEditor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AutoVideoEditor.App.Views"
        xmlns:viewmodels="clr-namespace:AutoVideoEditor.App.ViewModels"
        mc:Ignorable="d"
        Title="Auto Video Editor — Tự Động Dựng Video Hàng Loạt Native C#"
        Height="820" Width="1300"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#09090b" Foreground="#f4f4f5"
        FontFamily="Segoe UI, sans-serif">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:QueueViewModel}">
            <views:QueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PreviewViewModel}">
            <views:PreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PresetViewModel}">
            <views:PresetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#121215" BorderBrush="#27272a" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0" Margin="4,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" FontSize="24" Foreground="#06b6d4" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="AutoVideo" FontSize="20" FontWeight="Bold" Foreground="#f4f4f5" VerticalAlignment="Center" />
                        <TextBlock Text="Editor" FontSize="20" FontWeight="Bold" Foreground="#06b6d4" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Tự động hóa dựng video hàng loạt" FontSize="11" Foreground="#71717a" Margin="32,2,0,0" />
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="2">
                    <RadioButton Content="⚡  Trang chủ" Style="{StaticResource NavButtonStyle}" IsChecked="True" Command="{Binding NavigateToCommand}" CommandParameter="Home" />
                    <RadioButton Content="📋  Hàng đợi" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToCommand}" CommandParameter="Queue" />
                    <RadioButton Content="👁️  Xem trước" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToCommand}" CommandParameter="Preview" />
                    <RadioButton Content="⚙️  Mẫu xuất (Presets)" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToCommand}" CommandParameter="Presets" />
                    <RadioButton Content="🛠️  Cài đặt" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToCommand}" CommandParameter="Settings" />
                    <RadioButton Content="📜  Nhật ký (Logs)" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateToCommand}" CommandParameter="Logs" />
                </StackPanel>

                <!-- System Info Footer -->
                <Border Grid.Row="3" Background="#18181b" BorderBrush="#27272a" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding GpuStatusText}" FontSize="11" Foreground="#a1a1aa" TextWrapping="Wrap" />
                        <Separator Background="#27272a" Margin="0,8" />
                        <TextBlock Text="{Binding FfmpegStatusText}" FontSize="10" Foreground="#71717a" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#121215" BorderBrush="#27272a" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentViewTitle}" FontSize="18" FontWeight="Bold" Foreground="#f4f4f5" VerticalAlignment="Center" />

                    <!-- Global Progress Indicator (visible if processing) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding OverallProgress, StringFormat='Tiến độ toàn bộ: {0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="#10b981" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ProgressSummaryText}" FontSize="11" Foreground="#a1a1aa" HorizontalAlignment="Right" />
                        </StackPanel>
                        <ProgressBar Value="{Binding OverallProgress}" Width="160" Height="8" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
